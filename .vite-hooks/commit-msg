#!/usr/bin/env sh
ROOT_DIR="$(git rev-parse --show-toplevel)"

if command -v node >/dev/null 2>&1; then
  node "$ROOT_DIR/scripts/validate-commit-msg.cjs" "$1"
elif command -v bash >/dev/null 2>&1; then
  bash "$ROOT_DIR/scripts/validate-commit-msg.sh" "$1"
else
  sh "$ROOT_DIR/scripts/validate-commit-msg.sh" "$1"
fi
